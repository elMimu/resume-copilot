{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "basics",
    "career",
    "work",
    "education",
    "projects",
    "skills",
    "computerScience",
    "languages",
    "awards"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.1"]
    },
    "basics": {
      "$ref": "#/$defs/basics"
    },
    "career": {
      "$ref": "#/$defs/career"
    },
    "work": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "education": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/education"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "computerScience": {
      "$ref": "#/$defs/computerScience"
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "email",
        "phone",
        "location",
        "linkedin",
        "github",
        "portfolio",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "$ref": "#/$defs/nullableString"
        },
        "location": {
          "type": "string"
        },
        "linkedin": {
          "$ref": "#/$defs/nullableString"
        },
        "github": {
          "$ref": "#/$defs/nullableString"
        },
        "portfolio": {
          "$ref": "#/$defs/nullableString"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "career": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "targetRoles", "interests"],
      "properties": {
        "objective": {
          "type": "string"
        },
        "targetRoles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "technologies", "skills", "evidenceStrength"],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceStrength": {
          "type": "string",
          "enum": ["strong", "partial", "weak"]
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "company",
        "role",
        "location",
        "startDate",
        "endDate",
        "summary",
        "technologies",
        "skills",
        "achievements",
        "responsibilities"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/nullableString"
        },
        "startDate": {
          "$ref": "#/$defs/nullableString"
        },
        "endDate": {
          "$ref": "#/$defs/nullableString"
        },
        "summary": {
          "type": "string"
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "achievements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/achievement"
          }
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institution", "degree", "startDate", "endDate", "details"],
      "properties": {
        "institution": {
          "type": "string"
        },
        "degree": {
          "type": "string"
        },
        "startDate": {
          "$ref": "#/$defs/nullableString"
        },
        "endDate": {
          "$ref": "#/$defs/nullableString"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "technologies",
        "skills",
        "highlights"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "evidence"],
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "computerScience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fundamentals"],
      "properties": {
        "fundamentals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "level"],
      "properties": {
        "language": {
          "type": "string"
        },
        "level": {
          "type": "string"
        }
      }
    }
  }
}
